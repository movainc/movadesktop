# ─────────────────────────────────────────────────────────────────────────────
# mova — local development environment
# Copy this file to `.env.local` (git-ignored) and fill in your values.
#   cp .env.example .env.local
# Never commit real keys. `.env`, `.env.local` etc. are ignored by git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Desktop app (read at runtime by `npm run tauri dev`; debug builds only) ──

# Google OAuth client of type "Desktop app" (Google Cloud → Google Auth Platform → Clients).
# Optional: you can instead paste the client JSON on the app's sign-in screen.
MOVA_GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz012345.apps.googleusercontent.com
MOVA_GOOGLE_CLIENT_SECRET=GOCSPX-example-desktop-client-secret

# OpenAI API key for the AI assistant (desktop only). Optional: or add it in Settings → AI.
MOVA_OPENAI_API_KEY=sk-example-openai-key

# ── Web app (read by Vite: `npm run dev:web` / `npm run build:web`) ──

# Google OAuth client of type "Web application".
# Authorized JavaScript origins must include http://localhost:1420 for local dev.
VITE_GOOGLE_CLIENT_ID=123456789012-webclientexample0123456789abcdef.apps.googleusercontent.com

# Vercel project: movadesktopweb  →  https://movadesktopweb.vercel.app
# Add these in Vercel → Project → Settings → Environment Variables (Production + Preview).

# Which site the repository-root build produces. Only needed if Root Directory is the repo root (./).
MOVA_SITE=web

# Client ID of the "Web application" OAuth client.
# Authorized JavaScript origins: https://movadesktopweb.vercel.app
VITE_GOOGLE_CLIENT_ID=123456789012-webclientexample0123456789abcdef.apps.googleusercontent.com
